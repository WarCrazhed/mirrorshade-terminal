# ── macOS ───────────────────────────────────────────────
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

# ── Node / pnpm ─────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
# Solo pnpm: si aparece un lock de npm/yarn es un error
package-lock.json
yarn.lock

# ── SvelteKit / Vite (frontend) ─────────────────────────
/build/
/.svelte-kit/
/package/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ── Rust / Tauri ────────────────────────────────────────
# Cargo.lock SÍ se versiona (es una app, builds reproducibles)
/src-tauri/target/
/src-tauri/gen/schemas/
# Salidas de `pnpm tauri icon` que no usamos (solo macOS)
/src-tauri/icons/android/
/src-tauri/icons/ios/
/src-tauri/icons/Square*Logo.png
/src-tauri/icons/StoreLogo.png
**/*.rs.bk
*.pdb

# ── Binarios y paquetes ─────────────────────────────────
*.dmg
*.app/
*.tar.gz
*.zip

# ── Secretos y entorno ──────────────────────────────────
# La API key de Claude vive en el Llavero; nunca en archivos
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision
# Datos de usuario si alguien los copia al repo para depurar
history.db
history.db-*
settings.json.bak

# ── Logs y temporales ───────────────────────────────────
*.log
*.tmp
*.orig
*.rej
.cache/
coverage/

# ── Editores ────────────────────────────────────────────
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

