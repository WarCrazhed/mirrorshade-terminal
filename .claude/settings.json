{
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm -s check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm audit)",
      "Bash(pnpm build)",
      "Bash(pnpm build:local)",
      "Bash(pnpm build:cloud)",
      "Bash(pnpm tauri dev)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo audit)",
      "Bash(cargo deny check:*)"
    ],
    "deny": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh\"",
            "timeout": 180,
            "statusMessage": "svelte-check / cargo check…"
          }
        ]
      }
    ]
  }
}
